#!7/usr/bin/env python3
"""Convert DXF linework into thin 3D IFC solids.

Output geometry:
- IfcBuildingElementProxy
- IfcShapeRepresentation: Body / SweptSolid
- one IfcExtrudedAreaSolid with IfcRectangleProfileDef per CAD segment

All source Z coordinates are discarded after CAD block transformations.
Every solid starts at global Z=0 and is extruded vertically by a uniform height.

Supported CAD geometry:
- LINE
- LWPOLYLINE / POLYLINE, including bulge arcs after decomposition
- ARC / CIRCLE
- ELLIPSE
- SPLINE
- geometry nested in INSERT block references

DXF files are read directly by ezdxf.

When started without command-line arguments, a minimal Tkinter desktop
interface opens for choosing the source DXF file. The IFC is written next to
the DXF with the same base name.
"""

from __future__ import annotations

import argparse
import logging
import math
import sys
from collections import defaultdict
from pathlib import Path
from typing import Iterable, Iterator, Sequence

import ezdxf
from ezdxf import recover, units
from ezdxf.disassemble import recursive_decompose
from ezdxf.entities import DXFEntity
from ezdxf.math import Vec3
from ezdxf.path import make_path

import ifcopenshell
import ifcopenshell.api.aggregate
import ifcopenshell.api.context
import ifcopenshell.api.geometry
import ifcopenshell.api.layer
import ifcopenshell.api.project
import ifcopenshell.api.pset
import ifcopenshell.api.root
import ifcopenshell.api.spatial
import ifcopenshell.api.unit

LOG = logging.getLogger("dxf_to_ifc")

SUPPORTED_TYPES = {
    "LINE",
    "LWPOLYLINE",
    "POLYLINE",
    "ARC",
    "CIRCLE",
    "ELLIPSE",
    "SPLINE",
}

UNIT_CODES = {
    "in": units.IN,
    "inch": units.IN,
    "inches": units.IN,
    "ft": units.FT,
    "feet": units.FT,
    "mm": units.MM,
    "millimeter": units.MM,
    "millimeters": units.MM,
    "cm": units.CM,
    "centimeter": units.CM,
    "centimeters": units.CM,
    "m": units.M,
    "meter": units.M,
    "meters": units.M,
    "km": units.KM,
}

EPSILON_M = 1e-9
VERSION = "2.2.0"

DEFAULT_SOURCE_UNIT = "mm"
DEFAULT_TOLERANCE = 1.0
DEFAULT_LINE_WIDTH_MM = 3.0
DEFAULT_LINE_HEIGHT_MM = 2.0
DEFAULT_CHUNK_SIZE = 500


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description=(
            "Convert DXF line geometry into thin IFC4 3D solids "
            "stored as IfcBuildingElementProxy. Run without arguments for GUI."
        )
    )
    parser.add_argument("--version", action="version", version=f"%(prog)s {VERSION}")
    parser.add_argument("input", nargs="?", type=Path, help="Input .dxf file")
    parser.add_argument(
        "output",
        nargs="?",
        type=Path,
        help="Output .ifc file; defaults to the input name with .ifc extension",
    )
    parser.add_argument(
        "--unit",
        default=DEFAULT_SOURCE_UNIT,
        choices=["auto", "mm", "cm", "m", "in", "ft"],
        help=f"Source drawing unit (default: {DEFAULT_SOURCE_UNIT}).",
    )
    parser.add_argument(
        "--tolerance",
        type=float,
        default=DEFAULT_TOLERANCE,
        help=(
            "Maximum curve approximation deviation in source drawing units "
            f"(default: {DEFAULT_TOLERANCE})."
        ),
    )
    parser.add_argument(
        "--line-width-mm", "--width-mm",
        type=float,
        default=DEFAULT_LINE_WIDTH_MM,
        help=f"Width of every line solid in millimetres (default: {DEFAULT_LINE_WIDTH_MM}).",
    )
    parser.add_argument(
        "--line-height-mm", "--height-mm",
        type=float,
        default=DEFAULT_LINE_HEIGHT_MM,
        help=f"Height of every line solid in millimetres (default: {DEFAULT_LINE_HEIGHT_MM}).",
    )
    parser.add_argument(
        "--chunk-size",
        type=int,
        default=DEFAULT_CHUNK_SIZE,
        help=f"Maximum source curves per IFC proxy (default: {DEFAULT_CHUNK_SIZE}).",
    )
    parser.add_argument(
        "--include-layer", action="append", default=[],
        help="Only include this exact CAD layer. May be supplied multiple times.",
    )
    parser.add_argument(
        "--exclude-layer", action="append", default=[],
        help="Exclude this exact CAD layer. May be supplied multiple times.",
    )
    parser.add_argument(
        "--origin", nargs=3, type=float, metavar=("X", "Y", "Z"),
        default=(0.0, 0.0, 0.0),
        help="Subtract X and Y before writing IFC; source Z is always discarded.",
    )
    parser.add_argument("--gui", action="store_true", help="Open the desktop interface.")
    parser.add_argument("--verbose", action="store_true", help="Enable detailed logging.")
    return parser.parse_args()


def load_cad(path: Path) -> ezdxf.document.Drawing:
    if not path.exists():
        raise FileNotFoundError(path)

    if path.suffix.lower() != ".dxf":
        raise ValueError("Input must have .dxf extension")

    LOG.info("Reading DXF: %s", path)
    try:
        return ezdxf.readfile(path)
    except ezdxf.DXFStructureError:
        LOG.warning("DXF structure error; attempting recovery.")
        doc, auditor = recover.readfile(path)
        if auditor.has_errors:
            LOG.warning("DXF recovery reported %d errors.", len(auditor.errors))
        return doc


def source_to_metre_scale(doc: ezdxf.document.Drawing, unit_arg: str) -> float:
    if unit_arg != "auto":
        return float(units.conversion_factor(UNIT_CODES[unit_arg], units.M))

    code = int(doc.units)
    if code == 0:
        LOG.warning(
            "Drawing $INSUNITS is unitless; assuming millimetres. "
            "Override with --unit when needed."
        )
        code = units.MM

    try:
        scale = float(units.conversion_factor(code, units.M))
    except (TypeError, ValueError) as exc:
        raise ValueError(
            f"Unsupported or unknown DXF unit code {code}; specify --unit explicitly."
        ) from exc

    LOG.info("Source unit: %s; scale to metres: %.12g", units.unit_name(code), scale)
    return scale


def flatten_xy(point: Vec3) -> Vec3:
    """Project a transformed CAD point to the global XY plane."""
    p = Vec3(point)
    return Vec3(float(p.x), float(p.y), 0.0)


def clean_points(points: Iterable[Vec3], epsilon: float = 1e-12) -> list[Vec3]:
    """Flatten to Z=0 and remove consecutive duplicate XY vertices."""
    result: list[Vec3] = []
    for point in points:
        p = flatten_xy(point)
        if not result or not p.isclose(result[-1], abs_tol=epsilon):
            result.append(p)
    return result


def entity_to_points(entity: DXFEntity, tolerance: float) -> list[Vec3] | None:
    entity_type = entity.dxftype()

    if entity_type == "LINE":
        points = [Vec3(entity.dxf.start), Vec3(entity.dxf.end)]
    elif entity_type in SUPPORTED_TYPES:
        try:
            path = make_path(entity)
            points = list(path.flattening(distance=tolerance, segments=4))
        except (TypeError, ValueError, ZeroDivisionError) as exc:
            LOG.warning(
                "Skipping %s handle=%s: %s",
                entity_type,
                getattr(entity.dxf, "handle", "?"),
                exc,
            )
            return None
    else:
        return None

    # recursive_decompose() has already applied INSERT transformations.
    # Flatten only after that transformation so every resulting WCS point gets Z=0.
    points = clean_points(points)
    if len(points) < 2:
        return None
    return points


def collect_linework(
    doc: ezdxf.document.Drawing,
    tolerance: float,
    include_layers: set[str],
    exclude_layers: set[str],
) -> tuple[dict[str, list[list[Vec3]]], dict[str, int]]:
    by_layer: dict[str, list[list[Vec3]]] = defaultdict(list)
    stats: dict[str, int] = defaultdict(int)

    # Expands INSERT blocks and compound entities into transformed virtual primitives.
    for entity in recursive_decompose(doc.modelspace()):
        entity_type = entity.dxftype()
        layer = str(getattr(entity.dxf, "layer", "0") or "0")

        if include_layers and layer not in include_layers:
            stats["filtered"] += 1
            continue
        if layer in exclude_layers:
            stats["filtered"] += 1
            continue

        points = entity_to_points(entity, tolerance)
        if points is None:
            stats[f"skipped_{entity_type}"] += 1
            continue

        by_layer[layer].append(points)
        stats[entity_type] += 1
        stats["curves"] += 1
        stats["vertices"] += len(points)
        stats["segments"] += max(0, len(points) - 1)

    return dict(by_layer), dict(stats)


def chunks(values: Sequence[list[Vec3]], size: int) -> Iterator[Sequence[list[Vec3]]]:
    for index in range(0, len(values), size):
        yield values[index : index + size]


def create_ifc_base() -> tuple[
    ifcopenshell.file,
    ifcopenshell.entity_instance,
    ifcopenshell.entity_instance,
]:
    model = ifcopenshell.api.project.create_file(version="IFC4")

    project = ifcopenshell.api.root.create_entity(
        model, ifc_class="IfcProject", name="DXF Solid Linework Import"
    )

    metre = ifcopenshell.api.unit.add_si_unit(model, unit_type="LENGTHUNIT")
    ifcopenshell.api.unit.assign_unit(model, units=[metre])

    model_context = ifcopenshell.api.context.add_context(
        model, context_type="Model"
    )
    body_context = ifcopenshell.api.context.add_context(
        model,
        context_type="Model",
        context_identifier="Body",
        target_view="MODEL_VIEW",
        parent=model_context,
    )

    site = ifcopenshell.api.root.create_entity(
        model, ifc_class="IfcSite", name="Imported CAD Site"
    )
    building = ifcopenshell.api.root.create_entity(
        model, ifc_class="IfcBuilding", name="Imported CAD Building"
    )
    storey = ifcopenshell.api.root.create_entity(
        model, ifc_class="IfcBuildingStorey", name="CAD Solid Linework"
    )
    storey.Elevation = 0.0

    ifcopenshell.api.aggregate.assign_object(
        model, products=[site], relating_object=project
    )
    ifcopenshell.api.aggregate.assign_object(
        model, products=[building], relating_object=site
    )
    ifcopenshell.api.aggregate.assign_object(
        model, products=[storey], relating_object=building
    )

    # All spatial placements are explicit identity matrices at global Z=0.
    for product in (site, building, storey):
        ifcopenshell.api.geometry.edit_object_placement(model, product=product)

    return model, body_context, storey


def point_to_xy_metres(
    point: Vec3,
    scale_to_m: float,
    origin: tuple[float, float, float],
) -> tuple[float, float]:
    """Return only X/Y; source Z is intentionally ignored."""
    return (
        (float(point.x) - origin[0]) * scale_to_m,
        (float(point.y) - origin[1]) * scale_to_m,
    )


def make_axis2placement2d(model: ifcopenshell.file) -> ifcopenshell.entity_instance:
    return model.create_entity(
        "IfcAxis2Placement2D",
        Location=model.create_entity(
            "IfcCartesianPoint", Coordinates=(0.0, 0.0)
        ),
        RefDirection=model.create_entity(
            "IfcDirection", DirectionRatios=(1.0, 0.0)
        ),
    )


def make_segment_solid(
    model: ifcopenshell.file,
    start_xy: tuple[float, float],
    end_xy: tuple[float, float],
    width_m: float,
    height_m: float,
) -> ifcopenshell.entity_instance | None:
    """Create a rectangular prism whose base is exactly on global Z=0."""
    x1, y1 = start_xy
    x2, y2 = end_xy
    dx = x2 - x1
    dy = y2 - y1
    length = math.hypot(dx, dy)
    if length <= EPSILON_M:
        return None

    ux = dx / length
    uy = dy / length
    mid_x = (x1 + x2) * 0.5
    mid_y = (y1 + y2) * 0.5

    profile = model.create_entity(
        "IfcRectangleProfileDef",
        ProfileType="AREA",
        ProfileName="DWG line rectangular profile",
        Position=make_axis2placement2d(model),
        XDim=float(length),
        YDim=float(width_m),
    )

    # The profile's local X axis follows the CAD segment. Its placement Z is 0.
    solid_position = model.create_entity(
        "IfcAxis2Placement3D",
        Location=model.create_entity(
            "IfcCartesianPoint",
            Coordinates=(float(mid_x), float(mid_y), 0.0),
        ),
        Axis=model.create_entity(
            "IfcDirection", DirectionRatios=(0.0, 0.0, 1.0)
        ),
        RefDirection=model.create_entity(
            "IfcDirection", DirectionRatios=(float(ux), float(uy), 0.0)
        ),
    )

    return model.create_entity(
        "IfcExtrudedAreaSolid",
        SweptArea=profile,
        Position=solid_position,
        ExtrudedDirection=model.create_entity(
            "IfcDirection", DirectionRatios=(0.0, 0.0, 1.0)
        ),
        Depth=float(height_m),
    )


def make_chunk_solids(
    model: ifcopenshell.file,
    curve_chunk: Sequence[list[Vec3]],
    scale_to_m: float,
    origin: tuple[float, float, float],
    width_m: float,
    height_m: float,
) -> tuple[list[ifcopenshell.entity_instance], int]:
    solids: list[ifcopenshell.entity_instance] = []
    skipped_zero_length = 0

    for polyline in curve_chunk:
        xy_points = [
            point_to_xy_metres(point, scale_to_m, origin) for point in polyline
        ]
        for start_xy, end_xy in zip(xy_points, xy_points[1:]):
            solid = make_segment_solid(
                model=model,
                start_xy=start_xy,
                end_xy=end_xy,
                width_m=width_m,
                height_m=height_m,
            )
            if solid is None:
                skipped_zero_length += 1
                continue
            solids.append(solid)

    return solids, skipped_zero_length


def validate_model(
    model: ifcopenshell.file,
    expected_height_m: float,
    tolerance: float = 1e-9,
) -> tuple[int, int]:
    """Fail if annotations or non-flat solid placements remain."""
    annotations = model.by_type("IfcAnnotation")
    if annotations:
        raise RuntimeError(
            f"Internal validation failed: {len(annotations)} IfcAnnotation objects remain."
        )

    curves = (
        model.by_type("IfcPolyline")
        + model.by_type("IfcGeometricCurveSet")
    )
    if curves:
        raise RuntimeError(
            "Internal validation failed: curve geometry remains in the IFC."
        )

    proxies = model.by_type("IfcBuildingElementProxy")
    solids = model.by_type("IfcExtrudedAreaSolid")
    if not proxies or not solids:
        raise RuntimeError(
            "Internal validation failed: no proxy solid geometry was created."
        )

    for solid in solids:
        coords = tuple(float(v) for v in solid.Position.Location.Coordinates)
        z = coords[2] if len(coords) >= 3 else 0.0
        if abs(z) > tolerance:
            raise RuntimeError(
                f"Internal validation failed: solid #{solid.id()} starts at Z={z}."
            )

        direction = tuple(float(v) for v in solid.ExtrudedDirection.DirectionRatios)
        if len(direction) < 3 or any(
            abs(a - b) > tolerance
            for a, b in zip(direction[:3], (0.0, 0.0, 1.0))
        ):
            raise RuntimeError(
                f"Internal validation failed: solid #{solid.id()} has invalid extrusion direction."
            )

        if abs(float(solid.Depth) - expected_height_m) > tolerance:
            raise RuntimeError(
                f"Internal validation failed: solid #{solid.id()} has inconsistent height."
            )

    return len(proxies), len(solids)


def write_ifc(
    output: Path,
    source: Path,
    by_layer: dict[str, list[list[Vec3]]],
    scale_to_m: float,
    origin: tuple[float, float, float],
    chunk_size: int,
    line_width_mm: float,
    line_height_mm: float,
) -> tuple[int, int, int]:
    model, body_context, storey = create_ifc_base()

    width_m = line_width_mm / 1000.0
    height_m = line_height_mm / 1000.0
    proxy_count = 0
    solid_count = 0
    skipped_zero_length = 0

    for layer_name in sorted(by_layer):
        layer_curves = by_layer[layer_name]
        presentation_layer = ifcopenshell.api.layer.add_layer(
            model, name=layer_name
        )

        total_parts = math.ceil(len(layer_curves) / chunk_size)
        for part_number, curve_chunk in enumerate(
            chunks(layer_curves, chunk_size), start=1
        ):
            solids, skipped = make_chunk_solids(
                model=model,
                curve_chunk=curve_chunk,
                scale_to_m=scale_to_m,
                origin=origin,
                width_m=width_m,
                height_m=height_m,
            )
            skipped_zero_length += skipped
            if not solids:
                continue

            suffix = f" [{part_number}/{total_parts}]" if total_parts > 1 else ""
            proxy = ifcopenshell.api.root.create_entity(
                model,
                ifc_class="IfcBuildingElementProxy",
                name=f"CAD solids: {layer_name}{suffix}",
            )
            proxy.ObjectType = "DWG_LINE_SOLIDS"
            proxy.PredefinedType = "USERDEFINED"

            # Proxy placement is also identity at Z=0. Segment positions are in the body.
            ifcopenshell.api.geometry.edit_object_placement(
                model, product=proxy
            )

            representation = model.create_entity(
                "IfcShapeRepresentation",
                ContextOfItems=body_context,
                RepresentationIdentifier="Body",
                RepresentationType="SweptSolid",
                Items=solids,
            )
            ifcopenshell.api.geometry.assign_representation(
                model, product=proxy, representation=representation
            )
            ifcopenshell.api.spatial.assign_container(
                model, products=[proxy], relating_structure=storey
            )

            # Assign the actual solid representation items to the original CAD layer.
            ifcopenshell.api.layer.assign_layer(
                model, items=solids, layer=presentation_layer
            )

            pset = ifcopenshell.api.pset.add_pset(
                model, product=proxy, name="Pset_CADImport"
            )
            ifcopenshell.api.pset.edit_pset(
                model,
                pset=pset,
                properties={
                    "SourceFile": source.name,
                    "CADLayer": layer_name,
                    "SourceCurveCount": len(curve_chunk),
                    "SolidSegmentCount": len(solids),
                    "LineWidthMillimetres": line_width_mm,
                    "LineHeightMillimetres": line_height_mm,
                    "BaseElevation": 0.0,
                    "CoordinateScaleToMetres": scale_to_m,
                    "SourceOriginX": origin[0],
                    "SourceOriginY": origin[1],
                    "SourceOriginZIgnored": origin[2],
                },
            )

            proxy_count += 1
            solid_count += len(solids)

    validated_proxies, validated_solids = validate_model(
        model, expected_height_m=height_m
    )
    if validated_proxies != proxy_count or validated_solids != solid_count:
        raise RuntimeError("Internal validation counts do not match generated objects.")

    output.parent.mkdir(parents=True, exist_ok=True)
    model.write(str(output))

    # Reopen the serialized file to ensure the final STEP file contains no annotations
    # and all solid base placements still have Z=0.
    reopened = ifcopenshell.open(str(output))
    validate_model(reopened, expected_height_m=height_m)

    return proxy_count, solid_count, skipped_zero_length


def validate_options(
    tolerance: float,
    chunk_size: int,
    line_width_mm: float,
    line_height_mm: float,
) -> None:
    if tolerance <= 0:
        raise ValueError("Tolerance must be greater than zero")
    if chunk_size <= 0:
        raise ValueError("Chunk size must be greater than zero")
    if line_width_mm <= 0:
        raise ValueError("Line width must be greater than zero")
    if line_height_mm <= 0:
        raise ValueError("Line height must be greater than zero")


def convert_dxf_to_ifc(
    input_path: Path,
    output_path: Path,
    *,
    unit: str = DEFAULT_SOURCE_UNIT,
    tolerance: float = DEFAULT_TOLERANCE,
    line_width_mm: float = DEFAULT_LINE_WIDTH_MM,
    line_height_mm: float = DEFAULT_LINE_HEIGHT_MM,
    chunk_size: int = DEFAULT_CHUNK_SIZE,
    include_layers: set[str] | None = None,
    exclude_layers: set[str] | None = None,
    origin: tuple[float, float, float] = (0.0, 0.0, 0.0),
) -> tuple[int, int, int]:
    validate_options(tolerance, chunk_size, line_width_mm, line_height_mm)

    input_path = input_path.resolve()
    output_path = output_path.resolve()
    doc = load_cad(input_path)
    scale_to_m = source_to_metre_scale(doc, unit)
    linework, stats = collect_linework(
        doc,
        tolerance=tolerance,
        include_layers=include_layers or set(),
        exclude_layers=exclude_layers or set(),
    )

    if not linework:
        raise RuntimeError(
            "No supported line geometry was found in modelspace after filtering."
        )

    proxies, solids, skipped_zero_length = write_ifc(
        output=output_path,
        source=input_path,
        by_layer=linework,
        scale_to_m=scale_to_m,
        origin=origin,
        chunk_size=chunk_size,
        line_width_mm=line_width_mm,
        line_height_mm=line_height_mm,
    )

    LOG.info("IFC written: %s", output_path)
    LOG.info(
        "Layers=%d, source curves=%d, solid segments=%d, "
        "IfcBuildingElementProxy=%d, IfcAnnotation=0",
        len(linework), stats.get("curves", 0), solids, proxies,
    )
    LOG.info(
        "All solids: base Z=0, top Z=%.6f m, width=%.3f mm",
        line_height_mm / 1000.0, line_width_mm,
    )
    if skipped_zero_length:
        LOG.info("Skipped zero-length segments: %d", skipped_zero_length)

    skipped = sum(
        count for key, count in stats.items() if key.startswith("skipped_")
    )
    if skipped:
        LOG.info("Skipped unsupported/invalid entities: %d", skipped)

    return proxies, solids, skipped_zero_length


def run_gui() -> int:
    import threading
    import tkinter as tk
    from tkinter import filedialog, messagebox, ttk

    root = tk.Tk()
    root.title("DXF → IFC")
    root.resizable(False, False)

    selected_file = tk.StringVar()
    status = tk.StringVar(value="Выберите исходный DXF-файл")

    frame = ttk.Frame(root, padding=16)
    frame.grid(row=0, column=0, sticky="nsew")

    ttk.Label(frame, text="Исходный DXF:").grid(row=0, column=0, sticky="w")
    entry = ttk.Entry(frame, textvariable=selected_file, width=58, state="readonly")
    entry.grid(row=1, column=0, padx=(0, 8), pady=(4, 12))

    def choose_file() -> None:
        filename = filedialog.askopenfilename(
            title="Выберите DXF-файл",
            filetypes=[("DXF files", "*.dxf"), ("All files", "*.*")],
        )
        if filename:
            selected_file.set(filename)
            status.set(f"Результат: {Path(filename).with_suffix('.ifc').name}")
            convert_button.configure(state="normal")

    def finish_success(output_path: Path, proxies: int, solids: int) -> None:
        convert_button.configure(state="normal")
        choose_button.configure(state="normal")
        status.set(f"Готово: {output_path}")
        messagebox.showinfo(
            "DXF → IFC",
            f"IFC создан:\n{output_path}\n\n"
            f"IfcBuildingElementProxy: {proxies}\n"
            f"3D-сегментов: {solids}",
        )

    def finish_error(exc: Exception) -> None:
        convert_button.configure(state="normal")
        choose_button.configure(state="normal")
        status.set("Ошибка конвертации")
        messagebox.showerror("DXF → IFC", str(exc))

    def worker(input_path: Path, output_path: Path) -> None:
        try:
            proxies, solids, _ = convert_dxf_to_ifc(input_path, output_path)
        except Exception as exc:
            root.after(0, finish_error, exc)
        else:
            root.after(0, finish_success, output_path, proxies, solids)

    def start_conversion() -> None:
        value = selected_file.get().strip()
        if not value:
            messagebox.showwarning("DXF → IFC", "Сначала выберите DXF-файл.")
            return

        input_path = Path(value)
        output_path = input_path.with_suffix(".ifc")
        convert_button.configure(state="disabled")
        choose_button.configure(state="disabled")
        status.set("Конвертация…")
        threading.Thread(
            target=worker, args=(input_path, output_path), daemon=True
        ).start()

    choose_button = ttk.Button(frame, text="Выбрать…", command=choose_file)
    choose_button.grid(row=1, column=1, pady=(4, 12))

    convert_button = ttk.Button(
        frame, text="Преобразовать в IFC", command=start_conversion, state="disabled"
    )
    convert_button.grid(row=2, column=0, columnspan=2, sticky="ew")

    ttk.Label(frame, textvariable=status, wraplength=520).grid(
        row=3, column=0, columnspan=2, sticky="w", pady=(12, 0)
    )

    root.mainloop()
    return 0


def main() -> int:
    args = parse_args()
    logging.basicConfig(
        level=logging.DEBUG if args.verbose else logging.INFO,
        format="%(levelname)s: %(message)s",
    )

    if args.gui or args.input is None:
        return run_gui()

    input_path = args.input
    output_path = args.output or input_path.with_suffix(".ifc")
    origin = tuple(float(value) for value in args.origin)

    convert_dxf_to_ifc(
        input_path=input_path,
        output_path=output_path,
        unit=args.unit,
        tolerance=args.tolerance,
        line_width_mm=args.line_width_mm,
        line_height_mm=args.line_height_mm,
        chunk_size=args.chunk_size,
        include_layers=set(args.include_layer),
        exclude_layers=set(args.exclude_layer),
        origin=origin,
    )
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except Exception as exc:
        LOG.error("%s", exc)
        if "--verbose" in sys.argv:
            raise
        raise SystemExit(1)
